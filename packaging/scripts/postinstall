#!/bin/sh
set -eu
base='/Library/Application Support/MagicBayLTE'
/bin/mkdir -p "$base/logs"
/usr/sbin/chown root:wheel "$base" "$base/logs"
/bin/chmod 755 "$base" "$base/logs"
# A fresh installation must not silently opt into billable mobile data.
# Existing enabled/disabled intent is preserved on upgrade.
if [ ! -e "$base/preferences.json" ]; then
    /usr/bin/printf '%s\n' '{"enabled": false}' > "$base/preferences.json"
    /usr/sbin/chown root:wheel "$base/preferences.json"
    /bin/chmod 600 "$base/preferences.json"
fi
/bin/launchctl enable system/local.magicbay.lte.auto
/bin/launchctl bootstrap system /Library/LaunchDaemons/local.magicbay.lte.auto.plist
/usr/bin/python3 -c 'import sys; sys.path.insert(0,"/Library/Application Support/MagicBayLTE"); import lte_service; lte_service.wait_ready()'
echo 'MagicBayLTE 安装完成。请从“应用程序”打开 Magic Bay LTE，并按需启用 LTE。'
exit 0
