#!/bin/sh
set -eu
fail() { echo "MagicBayLTE: $*" >&2; exit 1; }
[ "${3:-/}" = / ] || fail '只支持安装到当前启动磁盘。'
[ "$(/usr/bin/uname -m)" = x86_64 ] || fail '此安装包只支持 Intel macOS。'
/usr/bin/xcode-select -p >/dev/null 2>&1 || fail '请先完成 xcode-select --install。'
/usr/bin/python3 -c 'import sys,ssl,ctypes; assert sys.version_info >= (3,9)' >/dev/null 2>&1 || fail '需要 Apple 命令行工具的 Python 3.9+；请先完成 xcode-select --install。'
/usr/bin/python3 -c 'import platform; assert int(platform.mac_ver()[0].split(".")[0]) >= 13' || fail '需要 macOS 13 或更新版本。'
base='/Library/Application Support/MagicBayLTE'
for path in "$base" "$base/logs" "$base/Source" '/Applications/Magic Bay LTE.app' '/Library/LaunchDaemons/local.magicbay.lte.auto.plist'; do
    [ ! -L "$path" ] || fail "检测到符号链接，请先检查：$path"
done
# Run only the already installed, administrator-owned teardown implementation.
# No Wi-Fi, proxy or physical interface configuration is changed.
if /bin/launchctl print system/local.magicbay.lte.auto >/dev/null 2>&1; then
    [ -f "$base/lte_service.py" ] || fail '旧助手缺少卸载程序，请先手动卸载旧版本。'
    /usr/bin/python3 -c 'from pathlib import Path; import stat; b=Path("/Library/Application Support/MagicBayLTE"); paths=[b]+list(b.glob("*.py")); assert all(not p.is_symlink() and p.stat().st_uid==0 and not p.stat().st_mode&0o022 for p in paths), "旧后台文件权限不安全，停止更新"'
    /usr/bin/python3 -c 'import sys; sys.path.insert(0,"/Library/Application Support/MagicBayLTE"); import lte_service; lte_service.hard_stop()'
fi
exit 0
